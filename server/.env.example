# Copiar a .env y llenar con valores reales. Nunca commitear el .env real.

# Cadena de conexión de PostgreSQL (Fase 7 en adelante — dónde se despliega
# se decide cuando llegue el momento, ver PLAN-MAESTRO "Qué falta decidir").
DATABASE_URL="postgresql://usuario:password@localhost:5432/mia?schema=public"

PUERTO=3000

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Deben ser DOS secretos distintos (acceso y refresco) para poder revocar uno sin invalidar el otro.
JWT_SECRETO_ACCESO=""
JWT_SECRETO_REFRESCO=""

JWT_EXPIRACION_ACCESO_MIN=15
JWT_EXPIRACION_REFRESCO_DIAS=30

# Fase 12 — CORS. Solo importa para llamadas desde navegador (Vite en dev, o
# un futuro dashboard web) — la app Android nativa no pasa por esto. Lista
# separada por comas. El default ya cubre Vite (5173) y los orígenes típicos
# de un WebView de Capacitor.
CORS_ORIGENES="http://localhost:5173,capacitor://localhost,http://localhost"

# Fase 11 (Google Play Billing) — opcional: sin esto, POST /billing/validar-compra
# responde 503 explícito (nunca inventa una compra válida). Se llena cuando
# exista la cuenta de desarrollador de Google Play + una cuenta de servicio
# de Google Cloud con acceso "Ver información financiera" en Play Console
# (Play Console → Configuración de la API → vincular proyecto de Google
# Cloud → crear cuenta de servicio → generar clave JSON). Acá va el
# contenido COMPLETO de ese JSON, como un solo string de una línea — no una
# ruta a archivo (Render no tiene filesystem persistente para eso).
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Email (solo lo usa "olvidé mi contraseña") — opcional: sin esto, esa ruta
# responde 503 explícito, nunca finge haber mandado el código. Crear cuenta
# gratis en resend.com, generar una API key. RESEND_FROM_EMAIL solo hace
# falta si verificas un dominio propio en Resend — si no, se usa su
# remitente de pruebas (onboarding@resend.dev).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# IA — opcional pero necesario para respuestas analíticas reales
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
GOOGLE_PLAY_PACKAGE_NAME="com.noah.conductor.atlas"
