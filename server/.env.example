# Copiar a .env y llenar con valores reales. Nunca commitear el .env real.

# Cadena de conexión de PostgreSQL (Fase 7 en adelante — dónde se despliega
# se decide cuando llegue el momento, ver PLAN-MAESTRO "Qué falta decidir").
DATABASE_URL="postgresql://usuario:password@localhost:5432/mia?schema=public"

PUERTO=3000

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Deben ser DOS secretos distintos (acceso y refresco) para poder revocar uno sin invalidar el otro.
JWT_SECRETO_ACCESO=""
JWT_SECRETO_REFRESCO=""

JWT_EXPIRACION_ACCESO_MIN=15
JWT_EXPIRACION_REFRESCO_DIAS=30

# Fase 12 — CORS. Solo importa para llamadas desde navegador (Vite en dev, o
# un futuro dashboard web) — la app Android nativa no pasa por esto. Lista
# separada por comas. El default ya cubre Vite (5173) y los orígenes típicos
# de un WebView de Capacitor.
CORS_ORIGENES="http://localhost:5173,capacitor://localhost,http://localhost"

# Fase 11 (Google Play Billing): NO hay variables de entorno todavía porque el
# verificador real contra la Play Developer API no está escrito (ver
# server/src/modules/billing/googlePlay.ts — stub a propósito, PLAN-MAESTRO
# "Estado real de Fase 11"). Cuando se implemente, previsiblemente hará falta
# algo como GOOGLE_SERVICE_ACCOUNT_JSON (credencial de la cuenta de servicio,
# o una ruta a ese archivo) y GOOGLE_PLAY_PACKAGE_NAME (para no aceptar un
# purchaseToken de otra app) — no se agregan ahora para no declarar variables
# "requeridas" que romperían el arranque del server sin necesidad.

# IA — opcional pero necesario para respuestas analíticas reales
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
GOOGLE_PLAY_PACKAGE_NAME="com.noah.conductor.atlas"
