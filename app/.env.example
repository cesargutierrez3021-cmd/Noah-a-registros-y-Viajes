# Copiar a .env y ajustar. Nunca commitear el .env real.
# Vite solo expone al cliente las variables que empiezan con VITE_.

# URL del backend (server/). Fase 10 es la primera vez que app/ necesita esto
# — ver PLAN-MAESTRO, D-11. En un emulador Android, "localhost" apunta al
# propio emulador, no a la PC: usar 10.0.2.2 en su lugar (valor estándar de
# Android para "la máquina que corre el emulador"). En un teléfono físico,
# usar la IP de la red local del backend, o la URL pública si ya está
# desplegado (ver "Qué falta decidir" en PLAN-MAESTRO).
VITE_API_URL="http://localhost:3000"
